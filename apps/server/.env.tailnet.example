# Dedicated tailnet node; no host ports or changes to the host's Tailscale daemon.
# Use the already verified local image ID, not a mutable production tag.
DSH_OCEAN_IMAGE=
# Official tailscale/tailscale@sha256:... image, downloaded and reviewed before use.
DSH_TAILSCALE_IMAGE=
DSH_OCEAN_NODE_NAME=ocean-remote-test
# Set to the actual separate node DNS name after interactive registration.
DSH_SERVER_PUBLIC_URL=https://ocean-remote-test.tailnet-name.ts.net
DSH_SERVER_ACCOUNT=owner@example.com
# Required: unique random password. Blank values make Compose refuse to start.
DSH_SERVER_PASSWORD=
